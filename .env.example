# ============================================================
#  D Finance AI Stock Manager — 環境変数一覧
#  このファイルをコピーして .env.local を作成してください。
#  Vercel: Dashboard > Settings > Environment Variables に同じ値を設定。
# ============================================================


# ─── Supabase（必須）───────────────────────────────────────
# https://supabase.com → Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # サーバーサイドのみ。公開厳禁。


# ─── Twelve Data（推奨・無料800 credits/日）────────────────
# https://twelvedata.com → Dashboard > API Keys
# 設定すると Yahoo Finance より優先されます。日本株も対応（7203:TSE形式）。

TWELVE_DATA_KEY=your_twelve_data_api_key_here


# ─── J-Quants（任意・日本株の空売り残高報告）────────────────
# https://jpx-jquants.com/
# 空売り残高報告（/markets/short-sale-report）はスタンダードプラン以上。
# 日本株（7203 / 7203.T）の銘柄詳細ページで表示されます。

JQUANTS_API_KEY=your_jquants_api_key_here


# ─── Cron認証（必須）──────────────────────────────────────
# ⚠️ 空白のままにすると毎日の自動更新が全て 401 エラーになります！
# openssl rand -hex 32 などで生成した文字列を設定してください。
# Vercel の Environment Variables にも同じ値を設定すること。

CRON_SECRET=your-random-secret-minimum-32-chars


# ─── OpenAI（任意・AI分析機能に必要）─────────────────────
# https://platform.openai.com → API keys
# 未設定の場合、ニュース分析はスキップされます。

OPENAI_API_KEY=sk-proj-...
OPENAI_NORMAL_MODEL=gpt-4o-mini
OPENAI_DETAILED_MODEL=gpt-4o


# ─── News API（任意・ニュース取得）────────────────────────
# https://newsapi.org（無料100 req/日、ローカル開発のみ）
# 本番では Developer plan $449/月 or NewsData.io $15/月 が必要。

NEWS_API_KEY=your_newsapi_key_here


# ─── Alpha Vantage（任意・最終バックアップ）───────────────
# https://alphavantage.co（25 req/日）
# ENABLE_ALPHA_VANTAGE_FALLBACK=true にすると有効化。

STOCK_API_KEY=your_alpha_vantage_key_here
ENABLE_ALPHA_VANTAGE_FALLBACK=false


# ─── データプロバイダー設定────────────────────────────────
# twelve_data | yahoo | alpha_vantage
# TWELVE_DATA_KEY 設定時は自動的に twelve_data が優先されます。

STOCK_DATA_PROVIDER=twelve_data


# ============================================================
#  【最小構成（今すぐ動かす）】
#
#  1. NEXT_PUBLIC_SUPABASE_URL
#  2. NEXT_PUBLIC_SUPABASE_ANON_KEY
#  3. SUPABASE_SERVICE_ROLE_KEY
#  4. CRON_SECRET（必ず空でない値！）
#  5. TWELVE_DATA_KEY（twelvedata.com で無料登録）
#
#  → データが自動更新されるようになります。
# ============================================================


# ─── Stripe（課金・Phase 2）────────────────────────────────
# https://dashboard.stripe.com → Developers > API keys
# 1. 商品を2つ作成（Pro / Premium、月額サブスクリプション）し Price ID を控える
# 2. Webhookエンドポイント https://<your-domain>/api/billing/webhook を登録
#    対象イベント: checkout.session.completed, customer.subscription.updated,
#                  customer.subscription.deleted → 署名シークレットを控える

STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...        # Pro（¥980/月）の Price ID
STRIPE_PRICE_PREMIUM=price_...    # Premium（¥2,980/月）の Price ID

# CheckoutのリダイレクトURLに使用（本番ドメイン）
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app


# ─── 事業者情報（特定商取引法に基づく表記・Phase 3）──────────
# /legal/tokushoho に表示されます。有料サービス公開時は記載が法令上必須です。
# 未設定の項目は画面に【要記入】と表示されます。

LEGAL_BUSINESS_NAME=          # 例: 〇〇株式会社 / 屋号
LEGAL_BUSINESS_OPERATOR=      # 運営統括責任者の氏名
LEGAL_BUSINESS_ADDRESS=       # 所在地
LEGAL_BUSINESS_PHONE=         # 電話番号（請求があれば遅滞なく開示でも可）
LEGAL_BUSINESS_CONTACT=       # 連絡先メールアドレス


# ─── Sentry（任意・エラー監視）───────────────────────────
# https://sentry.io でプロジェクト作成後に取得
# npm install @sentry/nextjs でインストール後に有効化される

NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxx
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=sntrys_xxxxx   # ソースマップアップロード用（任意）
